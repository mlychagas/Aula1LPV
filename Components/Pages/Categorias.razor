@page "/categorias"
@using AulaApp1.Components.Models

<h2>Categorias</h2>

<EditForm Model="novaCategoria" OnValidSubmit="AdicionarCategorias" class="card-body">
    <DataAnnotationsValidator/>

    <div class="mb-3">
        <label>Nome:</label>
        <InputText class="form-control"  @bind-Value="novaCategoria.Nome" />
        <ValidationMessage For="() => novaCategoria.Nome"/>
    </div>
    <div>
        <label>Quantidade:</label>
        <InputNumber class="form-control" @bind-Value="novaCategoria.Quantidade" />
        <ValidationMessage For="() => novaCategoria.Quantidade"/>
    </div>
    <div>
        <button type="submit" class="btn btn-primary mt-3">Adicionar</button>
    </div>
</EditForm>

<div class="col-md-4">
    @if (categorias.Count == 0)
    {
        <p>Nenhum categoria.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Quantidade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in categorias)
                {
                    <tr>
                        <td>@c.Nome</td>
                        <td>@c.Quantidade un</td>
                    </tr>

                }
            </tbody>
        </table>

    }
</div>


@code {
    private Categoria novaCategoria = new();
    
    private List<Categoria> categorias = new();
    
    private void AdicionarCategorias()
    {
        categorias.Add(novaCategoria);
        novaCategoria = new ();
        
    }

}